{
  "name": "sakya-farms",
  "version": "0.1.0",
  "private": true,
  "description": "Sakya Farms production commerce platform monorepo",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md,yaml,yml}\"",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "pnpm --filter @sakya/api db:migrate",
    "db:seed": "pnpm --filter @sakya/api db:seed",
    "catalog:import": "pnpm --filter @sakya/api catalog:import"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
