# ---------------------------------------------------------------------------
# Sakya Farms API — environment configuration
#
# Copy this file to `.env` in this directory (apps/api/.env):
#   cp apps/api/.env.example apps/api/.env
#
# `.env` is git-ignored. Never commit real secrets, and never reuse the example
# values below outside local development.
#
# Every variable here is validated at boot by src/config/env.validation.ts.
# If a required one is missing or malformed, the process exits with a report.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# REST base path. Routes are served under /<API_PREFIX>/v<API_VERSION>.
API_PREFIX=api
API_VERSION=1

# Comma-separated list of allowed browser origins. The mobile apps and the admin
# panel talk to this API over HTTP; PostgreSQL is never exposed to clients.
# In development each Expo web target and the admin panel are allowed.

# Set to true only when running behind a reverse proxy you control, so that
# X-Forwarded-For is trusted for client IPs (rate limiting, audit logs).
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Database (PostgreSQL is the single source of truth)
# ---------------------------------------------------------------------------
# Session Pooler connection string used because the direct hostname did not resolve.
DATABASE_URL=postgresql://postgres.zlpprvavknstlnxqscue:YUtVyCA2tYUmsbuB@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require

# Optional. Only needed when the migration role cannot create databases, so
# Prisma cannot create its own shadow database for `prisma migrate dev`.
# SHADOW_DATABASE_URL=postgresql://sakya:sakya_local_password@localhost:5432/sakya_farms_shadow?schema=public

# Driver-level pool size (pg). Keep it well below PostgreSQL's max_connections.
# Must stay BELOW the Supabase session pooler hard cap (15 clients): a larger
# pool exhausts it under modest concurrency (XX000 EMAXCONNSESSION 500s).
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Both secrets MUST be at least 32 characters and MUST be different from each
# other. Boot fails in production if the placeholder text is left in place.
JWT_ACCESS_SECRET=7lkAzl0q0dH4bg4r0+fFjZrIK8qv5Te3h6v0VQ4Dr08=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=4Gf8wHyD2yU3uSbJxL7NJ2A4PzR7gUm2w9Tx2L8qjE0=
JWT_REFRESH_TTL=30d
JWT_ISSUER=sakya-farms-api
JWT_AUDIENCE=sakya-farms-clients

# Argon2id parameters (OWASP baseline: 19 MiB, t=2, p=1).
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ---------------------------------------------------------------------------
# Rate limiting (per client IP)
# ---------------------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Leave blank to auto-select: pretty in development, JSON everywhere else.
# LOG_PRETTY=false

# ---------------------------------------------------------------------------
# Seeding (optional)
# ---------------------------------------------------------------------------
# prisma/seed.ts only creates an admin user when these are set. Without them it
# seeds roles and permissions and skips user creation, so no default password
# ever exists.
# SEED_ADMIN_EMAIL=admin@sakyafarms.example
# SEED_ADMIN_PASSWORD=use-a-long-unique-password-here
# SEED_ADMIN_FIRST_NAME=Sakya
# SEED_ADMIN_LAST_NAME=Admin

# Demo OTP mode (demo/staging builds): every phone verifies with this 4-digit code.
# Never has any effect in production.
OTP_DEMO_MODE=true
OTP_DEMO_CODE=123456

# ---------------------------------------------------------------------------
# SMS (OTP delivery via MSG91)
# ---------------------------------------------------------------------------
# Public IP 49.37.178.40 must stay whitelisted in the MSG91 dashboard (dynamic
# ISP - update it when calls start failing with an IP rejection).
#
# Auth key saved, but commented until the DLT-approved OTP template exists:
# boot validation requires the key + template as a pair, and India routes
# cannot deliver without DLT. Uncomment BOTH lines once the template is ready.
# MSG91_AUTH_KEY=573731A6NNTmFNX6ab170e6P1
# MSG91_OTP_TEMPLATE_ID=
# MSG91_SMS_FROM=SAKYAFRM

# --- Razorpay (test mode) ---
RAZORPAY_KEY_ID=rzp_test_ThAWMCJiMRWVej
RAZORPAY_KEY_SECRET=bnQxCNWJIT607Uv35zSgriub
RAZORPAY_WEBHOOK_SECRET=a972efbc63ce9965d679f202fff0ef9818e8ac1327acdf55
# --- Commerce rules (launch) ---
# Taxes are inclusive in displayed prices: no GST added at checkout.
TAX_RATE_PERCENT=0
# Flat delivery fee below the free-delivery threshold.
SHIPPING_FEE_IN_PAISE=4900
# Free delivery at/above 599 rupees.
FREE_SHIPPING_THRESHOLD_IN_PAISE=59900

# Web dev origins: Metro runs on 8081/8082 in this workspace, and LAN devices
# (phone via Expo Go / desktop via LAN IP) hit the API directly.
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006,http://localhost:3001,http://192.168.31.164:8081,http://192.168.31.164:8082,https://slingshot-agreeing-upward.ngrok-free.dev


