# ---------------------------------------------------------------------------
# Sakya Farms API — environment configuration
#
# Copy this file to `.env` in this directory (apps/api/.env):
#   cp apps/api/.env.example apps/api/.env
#
# `.env` is git-ignored. Never commit real secrets, and never reuse the example
# values below outside local development.
#
# Every variable here is validated at boot by src/config/env.validation.ts.
# If a required one is missing or malformed, the process exits with a report.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# REST base path. Routes are served under /<API_PREFIX>/v<API_VERSION>.
API_PREFIX=api
API_VERSION=1

# Comma-separated list of allowed browser origins. The mobile apps and the admin
# panel talk to this API over HTTP; PostgreSQL is never exposed to clients.
# In development each Expo web target and the admin panel are allowed.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3001

# Set to true only when running behind a reverse proxy you control, so that
# X-Forwarded-For is trusted for client IPs (rate limiting, audit logs).
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Database (PostgreSQL is the single source of truth)
# ---------------------------------------------------------------------------
# Must match the credentials in the root .env used by docker-compose.yml.
DATABASE_URL=postgresql://sakya:sakya_local_password@localhost:5432/sakya_farms?schema=public

# Optional. Only needed when the migration role cannot create databases, so
# Prisma cannot create its own shadow database for `prisma migrate dev`.
# SHADOW_DATABASE_URL=postgresql://sakya:sakya_local_password@localhost:5432/sakya_farms_shadow?schema=public

# Driver-level pool size (pg). Keep it well below PostgreSQL's max_connections.
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Both secrets MUST be at least 32 characters and MUST be different from each
# other. Boot fails in production if the placeholder text is left in place.
JWT_ACCESS_SECRET=replace-with-a-long-random-string-for-access-tokens
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-for-refresh-tokens
JWT_REFRESH_TTL=30d
JWT_ISSUER=sakya-farms-api
JWT_AUDIENCE=sakya-farms-clients

# Argon2id parameters (OWASP baseline: 19 MiB, t=2, p=1).
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ---------------------------------------------------------------------------
# Payments (provider adapters)
# ---------------------------------------------------------------------------
# HMAC secret for the non-production MOCK webhook adapter. Optional locally;
# the API falls back to a test-only default outside production. Real gateway
# credentials belong in the gateway adapter's own configuration, never here.
# PAYMENTS_MOCK_WEBHOOK_SECRET=replace-with-a-long-random-string-16-chars-min

# ---------------------------------------------------------------------------
# Rate limiting (per client IP)
# ---------------------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Leave blank to auto-select: pretty in development, JSON everywhere else.
# LOG_PRETTY=false

# ---------------------------------------------------------------------------
# Seeding (optional)
# ---------------------------------------------------------------------------
# prisma/seed.ts only creates an admin user when these are set. Without them it
# seeds roles and permissions and skips user creation, so no default password
# ever exists.
# SEED_ADMIN_EMAIL=admin@sakyafarms.example
# SEED_ADMIN_PASSWORD=use-a-long-unique-password-here
# SEED_ADMIN_FIRST_NAME=Sakya
# SEED_ADMIN_LAST_NAME=Admin
