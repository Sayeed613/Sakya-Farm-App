{
  "name": "@sakya/api",
  "version": "0.1.0",
  "private": true,
  "description": "Sakya Farms REST API (NestJS + Prisma + PostgreSQL)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && vitest run --passWithNoTests",
    "lint": "eslint .",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "catalog:normalize": "tsx prisma/normalize-catalog.ts",
    "catalog:import": "tsx prisma/import-catalog.ts",
    "catalog:import:apply": "tsx prisma/import-catalog.ts --apply"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/jwt": "12.0.1",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/throttler": "6.5.0",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sakya/types": "workspace:*",
    "@sakya/utils": "workspace:*",
    "@sakya/validation": "workspace:*",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "nestjs-pino": "5.1.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@types/express": "5.0.6",
    "@types/node": "25.9.3",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.23.1",
    "eslint": "10.10.0",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
