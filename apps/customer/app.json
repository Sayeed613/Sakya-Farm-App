{
  "expo": {
    "name": "Sakya Farms",
    "slug": "sakya-farms-customer",
    "version": "0.1.0",
    "scheme": "sakyafarms",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#FBF7F0",
    "web": {
      "output": "single",
      "favicon": "./public/favicon-48.png",
      "name": "Sakya Farms — Farm-Fresh Delivered",
      "themeColor": "#0B594C",
      "description": "Shop farm-fresh fruits, vegetables, ghee, pickles and cold-pressed oils from Sakya Farms. Delivered across Bengaluru."
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-asset",
      "expo-image",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sakyafarms.customer",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["tez", "phonepe", "paytmmp"]
      }
    },
    "android": {
      "package": "com.sakyafarms.customer",
      "softwareKeyboardLayoutMode": "resize"
    }
  }
}
