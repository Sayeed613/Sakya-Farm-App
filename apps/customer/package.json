{
  "name": "@sakya/customer",
  "version": "0.1.0",
  "private": true,
  "description": "Sakya Farms customer app (Expo + React Native + Expo Router)",
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform android --output-dir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "clean": "rm -rf dist .expo .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@react-native/virtualized-lists": "0.86.3",
    "@sakya/api-client": "workspace:*",
    "@sakya/types": "workspace:*",
    "@sakya/utils": "workspace:*",
    "@sakya/validation": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "babel-preset-expo": "~57.0.11",
    "expo": "57.0.23",
    "expo-asset": "~57.0.17",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.18",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "invariant": "2.2.4",
    "memoize-one": "6.0.0",
    "nativewind": "4.2.7",
    "nullthrows": "1.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "~4.5.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "@types/react": "19.2.4",
    "eslint": "10.10.0",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
