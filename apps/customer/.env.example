# Copy to `.env` and adjust for your machine.
#
# Base URL of the Sakya Farms API, INCLUDING the /api/v1 prefix. The app refuses
# to start its data layer without it (every screen will show an error state).
#
# Use your machine's LAN IP (not `localhost`) when running on a physical device.
# Use an https:// URL for any release build — Android blocks cleartext http in
# release, and an http API URL will silently fail on a real device.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Set to `true` ONLY in internal demo builds. When true the checkout screen
# offers the mock UPI/Card simulator (no real money). Must be `false`/absent in
# any build a customer can install.
EXPO_PUBLIC_PAYMENTS_DEMO=

# Support channels shown on Help & Support. Any channel left blank is hidden,
# so the app never offers a contact method that does not exist.
EXPO_PUBLIC_SUPPORT_PHONE=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_SUPPORT_WHATSAPP=
