{
  "$schema": "https://opencode.ai/config.json",
  "model": "apinex/free/gpt-6-luna",

  "compaction": {
    "auto": true,
    "prune": true,
    "keep": {
      "tokens": 3000
    },
    "buffer": 8000
  },

  "tool_output": {
    "max_lines": 500,
    "max_bytes": 20000
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "android/.gradle/**",
      "android/app/build/**",
      "ios/Pods/**",
      "ios/build/**",
      "dist/**",
      "build/**",
      "coverage/**"
    ]
  },

  "provider": {
    "apinex": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "APInex",
      "options": {
        "baseURL": "https://api.apinex.bond/v1"
      },
      "models": {
        "free/gpt-6-luna": {
          "name": "GPT-6 Luna",
          "limit": {
            "context": 16000,
  	    "output": 4096
          }
        }
      }
    }
  }
}